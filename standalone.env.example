# Standalone Xinchao + independently deployed Ombre Brain
AGENT_NAME=心潮
NOTIFICATION_RECIPIENT=你的人类
PORT=18110
SERVICE_TOKEN=generate-an-independent-random-secret-at-least-32-characters
SHADOW_MODE=false

# Existing Ombre Brain MCP. Keep OB independently deployable/updatable.
OMBRE_MCP_URL=https://your-ombre-brain.example.com/mcp
OMBRE_MCP_TOKEN=must-match-OMBRE_MCP_SERVICE_TOKEN-on-Ombre-Brain
OMBRE_READ_ENABLED=true
# Safe first deployment: Xinchao reads memory but does not auto-write dreams to OB.
OMBRE_WRITE_ENABLED=false
CONTEXT_OMBRE_ENABLED=true
OMBRE_BREATH_MAX_RESULTS=3
OMBRE_BREATH_MAX_TOKENS=800

CONTEXT_ENVELOPE_ENABLED=true
DREAM_ENABLED=true
DREAM_MIN_INTERVAL_HOURS=24
DREAM_MAX_PER_DAY=4

# Enable these after assigning independent secrets/public URLs when needed.
MCP_ENABLED=false
OAUTH_ENABLED=false
DASHBOARD_ENABLED=false
BARK_ENABLED=false
MODEL_ENABLED=false

SETTLE_TIME_ZONE=Asia/Shanghai
INTERACTION_TIME_ZONE=Asia/Shanghai
DAYTIME_TIME_ZONE=Asia/Shanghai
