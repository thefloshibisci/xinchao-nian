# Isolated Ombre Brain vNext service.
# Fill these values in Zeabur; do not commit a filled copy.

OMBRE_TRANSPORT=streamable-http
OMBRE_PORT=8000
OMBRE_BUCKETS_DIR=/app/buckets
OMBRE_CONFIG_PATH=/app/buckets/config.yaml
OMBRE_MCP_REQUIRE_AUTH=true

# Must match Xinchao OMBRE_MCP_TOKEN, and must be independent from every other secret.
OMBRE_MCP_SERVICE_TOKEN=replace-with-an-independent-random-secret-at-least-32-characters
OMBRE_DASHBOARD_PASSWORD=replace-with-an-independent-dashboard-password

# Optional model backends. Keep disabled or use vNext-only keys during the first boot.
OMBRE_COMPRESS_API_KEY=
OMBRE_COMPRESS_BASE_URL=
OMBRE_COMPRESS_MODEL=
OMBRE_EMBED_API_KEY=
OMBRE_EMBED_BASE_URL=
OMBRE_EMBED_MODEL=

# Optional OB sidecar callback to the isolated Xinchao service.
# Replace the host with Zeabur's private service address; do not use a production URL.
DYNAMIC_MIND_URL=http://<xinchao-private-host>:18110
DYNAMIC_MIND_TOKEN=replace-with-the-xinchao-service-token

# Keep the experiment's data on the dedicated Zeabur volume mounted at /app/buckets.
# Do not set OMBRE_HOST_VAULT_DIR to a production path.
