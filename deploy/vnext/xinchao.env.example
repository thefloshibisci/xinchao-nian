# Isolated Xinchao vNext service.
# Fill these values in Zeabur; do not commit a filled copy.

AGENT_NAME=心潮
NOTIFICATION_RECIPIENT=用户
PORT=18110
SHADOW_MODE=false

# This token is used by the Xinchao HTTP API and the OB sidecar callback.
# It must be different from the OB MCP token and OAuth approval token.
SERVICE_TOKEN=replace-with-an-independent-random-secret-at-least-32-characters

# Private address of the isolated OB service. Do not use the production OB URL.
OMBRE_MCP_URL=http://<ob-private-host>:8000/mcp
OMBRE_MCP_TOKEN=replace-with-the-ob-mcp-service-token
OMBRE_READ_ENABLED=true
# Keep false until the isolated data copy and write tests are ready.
OMBRE_WRITE_ENABLED=false
CONTEXT_OMBRE_ENABLED=true
OMBRE_BREATH_MAX_RESULTS=3
OMBRE_BREATH_MAX_TOKENS=800

# Cross-client continuity stays on the separate Xinchao state volume.
RECENT_CONTINUITY_ENABLED=true
RECENT_CONTINUITY_STATE_PATH=/app/state/recent-continuity.json
RECENT_CONTINUITY_PROFILE_ID=vnext-isolated
RECENT_CONTINUITY_TTL_HOURS=24
RECENT_CONTINUITY_MAX_CONTEXT_TURNS=8
CONTEXT_ENVELOPE_ENABLED=true
CONTEXT_DEFAULT_MAX_TOKENS=2200
CONTEXT_OMBRE_MAX_TOKENS=1600

# Public MCP boundary: assign the vNext-only HTTPS domain in Zeabur.
MCP_ENABLED=true
OAUTH_ENABLED=true
OAUTH_PUBLIC_BASE_URL=https://<vnext-xinchao-domain>
OAUTH_APPROVAL_TOKEN=replace-with-an-independent-oauth-approval-secret
OAUTH_STATE_PATH=/app/state/oauth.json

# Keep the visual Dashboard off until its own vNext URL and access token exist.
DASHBOARD_ENABLED=false
DASHBOARD_INCLUDE_PRIVATE_TEXT=false

DREAM_ENABLED=true
DREAM_MIN_INTERVAL_HOURS=24
DREAM_MAX_PER_DAY=4
MODEL_ENABLED=false
BARK_ENABLED=false
